{
  "name": "vectr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke=stress",
    "typecheck": "tsc --noEmit",
    "package:benchmark": "npm run build && electron-builder --dir",
    "benchmark": "npm run package:benchmark && node scripts/run-phase-one-benchmark.mjs",
    "test": "node --test tests/bench.test.ts tests/doc.test.ts tests/editor.test.ts tests/ui.test.ts tests/history.test.ts tests/layers.test.ts tests/text.test.ts tests/images.test.ts tests/shapes.test.ts tests/selection.test.ts tests/autosave.test.ts tests/files.test.ts tests/package.test.cjs"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "canvaskit-wasm": "^0.42.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.vectr.app",
    "productName": "Vectr",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "dir"
    }
  },
  "allowScripts": {}
}

